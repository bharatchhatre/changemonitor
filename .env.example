# Environment Configuration for Change Monitor
APP_NAME="Website Change Monitor"
APP_ENV=production
APP_SECRET="changeme_to_a_random_32_character_secret_key"
ADMIN_PASSWORD="admin" # Change this on initial setup or in settings UI
CRON_TOKEN="changeme_cron_secret_token_123"

# Data Storage Path (defaults to ../data)
DATA_PATH="../data"

# Notification Defaults (Can also be configured via Admin UI)
GMAIL_SMTP_HOST="smtp.gmail.com"
GMAIL_SMTP_PORT=587
GMAIL_SMTP_USER=""
GMAIL_SMTP_PASS="" # Google App Password (16 characters)
ALERT_EMAIL_TO=""

TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

OPENWA_API_URL=""
OPENWA_API_KEY=""
OPENWA_CHAT_ID=""
